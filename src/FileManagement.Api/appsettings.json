{
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Redis": {
    "Host": "",
    "Port": 6379,
    "Password": "",
    "UseSsl": false,
    "ConnectTimeoutMilliseconds": 1000,
    "OperationTimeoutMilliseconds": 500
  },
  "Minio": {
    "Endpoint": "",
    "PublicEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "files",
    "UseSsl": false,
    "PublicUseSsl": false
  },
  "Jwt": {
    "Issuer": "file-management-identity",
    "Audience": "file-management-services",
    "SigningKey": ""
  },
  "Seq": {
    "ServerUrl": ""
  },
  "FileUpload": {
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".pdf",
      ".png",
      ".jpg",
      ".jpeg",
      ".txt",
      ".docx",
      ".xlsx"
    ],
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "text/plain",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/octet-stream"
    ]
  },
  "FileCache": {
    "Enabled": false,
    "KeyPrefix": "file-management:local:files:v1",
    "DetailTtlSeconds": 300,
    "ListTtlSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:5173",
      "http://localhost:5173"
    ]
  }
}
