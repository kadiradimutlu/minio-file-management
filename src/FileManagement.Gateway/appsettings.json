{
  "ReverseProxy": {
    "Routes": {
      "identityRoute": {
        "ClusterId": "identityCluster",
        "Order": 0,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "fileRoute": {
        "ClusterId": "fileCluster",
        "Order": 10,
        "MaxRequestBodySize": 22020096,
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "identityApi": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "fileCluster": {
        "Destinations": {
          "fileApi": {
            "Address": "http://api:8080/"
          }
        }
      }
    }
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp.ReverseProxy": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
